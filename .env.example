# ============================================
# NullClaw AI Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================
# REQUIRED - Telegram Bot
# ============================================
# Get from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ============================================
# REQUIRED - AI Provider (OpenRouter)
# ============================================
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================
# OPTIONAL - AI Model Selection
# ============================================
# Default: google/gemini-2.0-flash-exp:free (free tier)
# Other options: anthropic/claude-3-haiku, meta-llama/llama-3.1-8b-instruct:free
AI_MODEL=google/gemini-2.0-flash-exp:free
AI_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ============================================
# OPTIONAL - Platform Settings
# ============================================
# Port for the health check / API server
PORT=3000

# Your Telegram chat ID (for admin notifications)
ADMIN_CHAT_ID=
