# Fly.io Environment Variables
# Copy these to your Fly.io app using: flyctl secrets set KEY=value

# ============================================
# REQUIRED - Add your OpenRouter API key
# ============================================
OPENROUTER_API_KEY=sk-or-v1-your-actual-key-here

# ============================================
# RECOMMENDED - Security
# ============================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# ============================================
# OPTIONAL - Configuration
# ============================================
ADMIN_EMAIL=admin@example.com
DATABASE_URL=sqlite:///app/data/platform.db
LOG_LEVEL=INFO

# ============================================
# OPTIONAL - Telegram Bot (for each customer)
# ============================================
# Add per-customer in their config, not here
# TELEGRAM_BOT_TOKEN=not-set-here
